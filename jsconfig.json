{
	"extends": "$app/tsconfig",
	"include": [
		"src",
		"test",
		"*"
	],
	"exclude": [
		"src/service-worker"
	],
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"moduleResolution": "NodeNext"
	}
}
